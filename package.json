{
  "name": "pro-presenter-lite",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:electron": "playwright test",
    "build:app": "npm run typecheck && vite build",
    "build": "npm run build:app && electron-builder",
    "package:check": "npm run build:app && electron-builder --dir && node scripts/check-ai-package.mjs",
    "preview": "vite preview",
    "lint": "eslint src",
    "format:check": "prettier --check electron src shared tests",
    "check:bundle": "node scripts/check-bundle.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build:app && npm run check:bundle && npm run test:electron",
    "release": "node scripts/check-release.mjs && npm run verify && node scripts/build-update-release.mjs",
    "icon:build": "node scripts/build-app-icon.mjs",
    "package:free": "npm run build:app && node scripts/build-update-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "1.32.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.575.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-resizable-panels": "^2.1.7",
    "react-rnd": "^10.5.2",
    "tailwind-merge": "^2.2.0",
    "zod": "^4.3.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.17",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "com.propre.presenter",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns"
    },
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "scripts/propre-mcp.mjs",
      "THIRD_PARTY_NOTICES.md",
      "third-party-licenses/**/*"
    ],
    "productName": "ProPre",
    "asar": true,
    "npmRebuild": false
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "description": "자료 자동 저장과 독립 메인·모니터 송출을 제공하는 로컬 프레젠테이션 앱"
}
